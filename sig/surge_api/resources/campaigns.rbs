module SurgeAPI
  module Resources
    class Campaigns
      def create: (
        String account_id,
        campaign_params: SurgeAPI::Models::campaign_params,
        ?request_options: SurgeAPI::request_opts
      ) -> SurgeAPI::Campaign

      def retrieve: (
        String id,
        ?request_options: SurgeAPI::request_opts
      ) -> SurgeAPI::Campaign

      def update: (
        String id,
        ?consent_flow: String,
        ?description: String,
        ?includes: ::Array[SurgeAPI::Models::CampaignUpdateParams::include_],
        ?link_sample: String?,
        ?message_samples: ::Array[String],
        ?privacy_policy_url: String,
        ?terms_and_conditions_url: String,
        ?use_cases: ::Array[SurgeAPI::Models::CampaignUpdateParams::use_case],
        ?volume: SurgeAPI::Models::CampaignUpdateParams::volume,
        ?request_options: SurgeAPI::request_opts
      ) -> SurgeAPI::Campaign

      def list: (
        String account_id,
        ?after: String,
        ?before: String,
        ?request_options: SurgeAPI::request_opts
      ) -> SurgeAPI::Internal::Cursor[SurgeAPI::Campaign]

      def resend_brand_verification_message: (
        String account_id,
        ?request_options: SurgeAPI::request_opts
      ) -> SurgeAPI::Models::CampaignResendBrandVerificationMessageResponse

      def initialize: (client: SurgeAPI::Client) -> void
    end
  end
end
